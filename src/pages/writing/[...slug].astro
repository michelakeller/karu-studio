---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, getWriting } from '../../lib/content';

export const getStaticPaths = (async () => {
  const entries = await getWriting();
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { title, description, publishedAt, author, tags, canonical } = entry.data;
const { Content } = await render(entry);
---

<Base title={title} description={description}>
  <article class="page section section--flush">
    <header>
      <p class="label">
        <time datetime={publishedAt.toISOString()}>{formatDate(publishedAt)}</time>
        {' / '}{author}
      </p>
      <h1 class="note__title">{title}</h1>
      <p class="note__standfirst">{description}</p>
      {
        canonical && (
          <p class="note__canonical">
            First published <a href={canonical} rel="noopener">elsewhere</a>.
          </p>
        )
      }
    </header>

    <div class="markdown note__body">
      <Content />
    </div>

    {
      tags.length > 0 && (
        <ul class="note__tags">
          {tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )
    }

    <p class="note__back"><a href="/writing">Back to writing</a></p>
  </article>
</Base>

<style>
  .note__title {
    margin-top: var(--space-l);
    font-size: var(--type-h2);
    max-width: 26ch;
  }

  .note__standfirst {
    margin-top: var(--space-m);
    font-size: var(--type-lede);
    line-height: 1.34;
    letter-spacing: var(--tracking-display);
    max-width: 44ch;
    color: var(--ink-soft);
  }

  .note__canonical {
    margin-top: var(--space-m);
    font-size: var(--type-small);
    color: var(--ink-faint);
  }

  .note__body {
    margin-top: var(--space-2xl);
    padding-top: var(--space-l);
    border-top: var(--hairline) solid var(--rule);
  }

  .note__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-xl);
    font-family: var(--font-mono);
    font-size: var(--type-micro);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .note__back {
    margin-top: var(--space-xl);
    padding-top: var(--space-m);
    border-top: var(--hairline) solid var(--rule);
    font-family: var(--font-ui);
    font-size: var(--type-small);
  }
</style>
