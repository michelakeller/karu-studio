---
import FrogMark from './FrogMark.astro';
import { site } from '../data/site';

const year = new Date().getFullYear();

/** An empty value in site.ts means the link is simply not shown. */
const links: { label: string; href: string }[] = [];
if (site.social.linkedin) {
  links.push({ label: 'LinkedIn', href: site.social.linkedin });
}
if (site.social.instagram) {
  links.push({ label: 'Instagram', href: site.social.instagram });
}
---

<footer class="footer site-footer">
  <div class="page footer__inner">
    <div class="footer__block">
      <p class="footer__mark">
        <FrogMark size={22} class="footer__frog" />
        <span>karu studio</span>
      </p>
      <p class="footer__line">
        karu comes from kaeru, which means luck, returning, and frog, all at once.
      </p>
    </div>

    <div class="footer__block">
      <p class="label">Start here</p>
      <a class="footer__email" href={`mailto:${site.email}`}>{site.email}</a>
    </div>

    {
      links.length > 0 && (
        <div class="footer__block">
          <p class="label">Elsewhere</p>
          <ul class="footer__links">
            {links.map((link) => (
              <li>
                <a href={link.href} rel="me noopener">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <p class="footer__legal">&copy; {year} karu studio</p>
  </div>
</footer>

<style>
  .footer {
    border-top: var(--hairline) solid var(--rule);
  }

  .footer__inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space-l);
    padding-block: var(--space-2xl) var(--space-l);
    align-items: start;
  }

  .footer__mark {
    display: flex;
    align-items: center;
    gap: 0.45em;
    font-family: var(--font-display);
    font-size: var(--type-h3);
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-display);
    line-height: 1;
  }

  .footer__line {
    margin-top: var(--space-s);
    font-size: var(--type-small);
    color: var(--ink-soft);
    max-width: 30ch;
  }

  .footer__block .label {
    margin-bottom: var(--space-xs);
  }

  .footer__email {
    font-size: var(--type-small);
  }

  .footer__links {
    display: grid;
    gap: var(--space-2xs);
    font-size: var(--type-small);
  }

  .footer__legal {
    grid-column: 1 / -1;
    margin-top: var(--space-l);
    padding-top: var(--space-m);
    border-top: var(--hairline) solid var(--rule);
    font-size: var(--type-micro);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-faint);
  }
</style>
