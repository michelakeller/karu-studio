---
import FrogMark from './FrogMark.astro';
import { site } from '../data/site';

const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href.startsWith('/#') ? false : path === href || path.startsWith(`${href}/`);
---

<header class="header site-header">
  <div class="page header__inner">
    <a class="wordmark" href="/" aria-label={`${site.name}, home`}>
      <FrogMark size={26} class="wordmark__frog" />
      <span class="wordmark__name">karu</span>
      <span class="wordmark__kind">studio</span>
    </a>

    <nav class="nav" aria-label="Primary">
      <ul class="nav__list">
        {
          site.nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="nav__link"
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 5;
    background-color: var(--first-ground);
    color: var(--first-ink);
    border-bottom: var(--hairline) solid var(--rule-on-deep);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    padding-block: var(--space-s);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    text-decoration: none;
    color: var(--first-ink);
  }

  .wordmark:hover {
    color: var(--paper-lift);
  }

  .wordmark__frog {
    transition: transform var(--duration-slow) var(--ease);
  }

  .wordmark:hover .wordmark__frog {
    transform: translateY(-3px);
  }

  .wordmark__name {
    font-family: var(--font-display);
    font-size: var(--type-h3);
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-display);
    line-height: 1;
  }

  .wordmark__kind {
    font-family: var(--font-display);
    font-size: var(--type-micro);
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-on-deep-soft);
    padding-bottom: 0.15em;
  }

  .nav__list {
    display: flex;
    gap: clamp(var(--space-m), 2.5vw, var(--space-xl));
  }

  .nav__link {
    font-size: var(--type-small);
    font-weight: var(--weight-medium);
    text-decoration: none;
    color: var(--first-ink);
  }

  .nav__link:hover {
    color: var(--paper-lift);
  }

  .nav__link[aria-current='page'] {
    color: var(--paper-lift);
  }

  .header :focus-visible {
    outline-color: var(--focus-ring-on-deep);
  }

  @media (max-width: 34rem) {
    .header__inner {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-xs);
    }

    .nav__list {
      gap: var(--space-m);
      flex-wrap: wrap;
    }
  }
</style>
